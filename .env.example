# AI provider keys are server-only. Primary and secondary keys are tried in order for automatic failover.
PRIMARY_API_KEY=
SECONDARY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY is supported as a documented Gemini fallback name.
GOOGLE_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL / Supabase. Keep the full connection string local and never commit it.
STORAGE_MODE=json
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=bid-documents
DOCUMENT_STORAGE=local
# Required only when DOCUMENT_STORAGE=supabase. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=
