# AI provider keys are server-only. OpenAI is tried first, then Gemini, then deterministic fallback.
OPENAI_API_KEY=
OPENAI_SECONDARY_API_KEY=
OPENAI_TERTIARY_API_KEY=
OPENAI_MODEL=gpt-6-luna
PRIMARY_API_KEY=
SECONDARY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY is supported as a documented Gemini fallback name.
GOOGLE_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL / Supabase. Keep the full connection string local and never commit it.
STORAGE_MODE=json
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=bid-documents
DOCUMENT_STORAGE=local
# Required only when DOCUMENT_STORAGE=supabase. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud mode. Uses Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
OCR_PROVIDER=local
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Set DOCUMENT_STORAGE=google-cloud-storage and OCR_PROVIDER=google-vision only after Google Cloud setup.
