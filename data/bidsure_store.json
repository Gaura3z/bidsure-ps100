  "requirements": [
    {
      "id": "req-01",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 3.1",
      "category": "STATUTORY",
      "title": "GST Registration",
      "description": "Bidder must possess a valid, active GSTIN registration under the GST Act.",
      "isMandatory": true,
      "isKnockout": true,
      "thresholdType": "EQUALS",
      "thresholdValue": "ACTIVE",
      "evidenceDocType": "GST Certificate",
      "sourceAdapter": "GSTN",
      "severity": "CRITICAL",
      "weight": 10,
      "ruleExpression": "source.status == \"ACTIVE\" && bidder.gstin == doc.extracted_gstin",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-02",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 3.2",
      "category": "STATUTORY",
      "title": "PAN Verification",
      "description": "Valid Permanent Account Number issued by Income Tax Department matching entity name.",
      "isMandatory": true,
      "isKnockout": true,
      "thresholdType": "EQUALS",
      "thresholdValue": "VALID",
      "evidenceDocType": "PAN Card",
      "sourceAdapter": "INCOME_TAX",
      "severity": "CRITICAL",
      "weight": 10,
      "ruleExpression": "source.pan_status == \"VALID\" && source.name_match >= 85",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-03",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 3.3",
      "category": "STATUTORY",
      "title": "Udyam Registration (MSME)",
      "description": "Udyam registration certificate if claiming MSE purchase preference or exemption benefits.",
      "isMandatory": false,
      "isKnockout": false,
      "thresholdType": "EXISTS",
      "thresholdValue": "VERIFIED",
      "evidenceDocType": "Udyam Certificate",
      "sourceAdapter": "UDYAM",
      "severity": "MEDIUM",
      "weight": 5,
      "ruleExpression": "claim_mse ? (source.status == \"VALID\" && source.nic_code_matches) : true",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-04",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 4.1",
      "category": "STATUTORY",
      "title": "Income Tax Return Compliance",
      "description": "Bidder must have submitted valid ITR acknowledgement for AY 2023-24 and AY 2024-25.",
      "isMandatory": true,
      "isKnockout": true,
      "thresholdType": "EQUALS",
      "thresholdValue": "FILED",
      "evidenceDocType": "ITR Acknowledgement",
      "sourceAdapter": "INCOME_TAX",
      "severity": "HIGH",
      "weight": 8,
      "ruleExpression": "doc.ay_2023_24_filed && doc.ay_2024_25_filed",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-05",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 5.2",
      "category": "FINANCIAL",
      "title": "Minimum Annual Turnover",
      "description": "Average annual audited turnover of the bidder for the last 3 financial years must be at least ₹5.00 Crore, certified by Chartered Accountant with valid UDIN.",
      "isMandatory": true,
      "isKnockout": true,
      "thresholdType": "MIN_NUMERIC",
      "thresholdValue": "50000000",
      "evidenceDocType": "Turnover Certificate",
      "sourceAdapter": "MANUAL",
      "severity": "CRITICAL",
      "weight": 15,
      "ruleExpression": "doc.audited_turnover >= 50000000 && doc.has_valid_ca_udin",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-06",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 6.1",
      "category": "TECHNICAL_EXPERIENCE",
      "title": "Technical Experience Criteria",
      "description": "Minimum 3 years of demonstrated experience in supplying enterprise IT / Server hardware to PSUs, Government Bodies, or Fortune 500 enterprises with satisfactory performance certificate.",
