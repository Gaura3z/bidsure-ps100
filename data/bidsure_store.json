      "evidenceDocType": "OEM Authorization",
      "sourceAdapter": "MANUAL",
      "severity": "CRITICAL",
      "weight": 12,
      "ruleExpression": "doc.tender_ref_matched && doc.oem_seal_verified && doc.warranty_years >= 5",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
