      "isKnockout": true,
      "thresholdType": "MIN_NUMERIC",
      "thresholdValue": "3",
      "evidenceDocType": "Experience Certificate",
      "sourceAdapter": "MANUAL",
      "severity": "HIGH",
      "weight": 12,
      "ruleExpression": "doc.experience_years >= 3 && doc.psu_orders_count >= 1",
      "createdAt": "2026-09-01T10:00:00Z"
    },
    {
      "id": "req-07",
      "tenderId": "tender-001",
      "clauseNumber": "Clause 7.1",
      "category": "OEM_AUTHORIZATION",
      "title": "OEM Manufacturer Authorization Form (MAF)",
